generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model User {
  id String @id
  logs UserModLog[]
}

model Guild {
  id String @id
  prefix String?
  log_chnl String?
  staff_roles Json?
  installed_packages Json?
  custom_commands GuildCustomCommands[]
}

model UserModLog {
  userid String 
  user User @relation(fields: [userid], references: [id])
  staff String?
  logid String @id
  action String
  reason String
  duration String?
  heatlvl String?
  timestamp String
}

model GuildCustomCommands {
  guildid String
  guild Guild @relation(fields: [guildid], references: [id])
  trigger String @id
  text String?
  title String?
  description String?
  image String?
  deltrig Boolean?
  permission String?
  name String?
  cooldown String?
}