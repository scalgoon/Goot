generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model User {
  id String @id
  logs UserModLog[]
}

model Guild {
  id String @id
  prefix String?
  log_chnl String?
}

model UserModLog {
  userid String 
  user User @relation(fields: [userid], references: [id])
  staff String?
  logid String @id
  action String
  reason String
  heatlvl String
  timestamp String
}

model Commands {
  placeholder String @unique @default("//k/")
  guild String
  guildName String
  text String?
  title String?
  description String?
  image String?
  deltrig Boolean?
  permission String?
  name String?
  cooldown String?
}